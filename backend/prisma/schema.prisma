generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Transaction {
  id Int @id @default(autoincrement())
  productID String
  productName String
  amount Int
  customerName String
  status Int @default(0)
  transactionDate DateTime @default(now())
  createBy String
  createOn DateTime @default(now())
}